#!/bin/sh
# Maven Wrapper simplificado: descarga Maven (una sola vez) en ~/.m2/wrapper
# y lo ejecuta con los argumentos recibidos. Uso: ./mvnw test
set -e
MAVEN_VERSION=3.9.9
WRAPPER_HOME="$HOME/.m2/wrapper/dists"
MAVEN_HOME="$WRAPPER_HOME/apache-maven-$MAVEN_VERSION"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"
BASE_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Descargando Maven $MAVEN_VERSION..."
  mkdir -p "$WRAPPER_HOME"
  TMP_ZIP="$(mktemp)"
  curl -fsSL "$MAVEN_URL" -o "$TMP_ZIP"
  unzip -q -o "$TMP_ZIP" -d "$WRAPPER_HOME"
  rm -f "$TMP_ZIP"
  chmod +x "$MAVEN_HOME/bin/mvn"
fi

exec "$MAVEN_HOME/bin/mvn" -f "$BASE_DIR/pom.xml" "$@"
